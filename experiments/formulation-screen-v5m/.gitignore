# Earlier stages remain local until their publication policy is defined.
/formulation-v5m1*-results/
/bench-v5m1*-results/
/validation-v5m2*-results/
__pycache__/

# V5m-2: ignore everything inside a run, then admit exact scientific artifacts.
# Do NOT ignore the run directory itself: Git must traverse it for exceptions.
# This includes predictive-v5m2-results and predictive-v5m2-<label>-results.
/predictive-v5m2*-results/*
!/predictive-v5m2*-results/summary.json
!/predictive-v5m2*-results/manifest.json
!/predictive-v5m2*-results/artifact-hashes.json
!/predictive-v5m2*-results/catalog.json
!/predictive-v5m2*-results/catalog.csv
!/predictive-v5m2*-results/catalog-rejections.csv
!/predictive-v5m2*-results/grid-plan.json
!/predictive-v5m2*-results/refinement-plan.json
!/predictive-v5m2*-results/prediction-grid.csv
!/predictive-v5m2*-results/predictions.json
!/predictive-v5m2*-results/coarse-tradeoffs.csv
!/predictive-v5m2*-results/tradeoffs.csv
!/predictive-v5m2*-results/pareto-thermodynamic.csv
!/predictive-v5m2*-results/pareto-with-flow-proxy.csv
!/predictive-v5m2*-results/refinement-diagnostics.csv
!/predictive-v5m2*-results/validation-shortlist.csv

# No nested directory is publishable, even if its name matches an allowed file.
# This excludes workers/, checkpoints/, source-cache/ and any new cache tree.
/predictive-v5m2*-results/*/

# Manual transfer bundles are unnecessary when results are shared through Git.
/*.zip
/*.tar
/*.tar.gz
/*.tgz

# Ignored files stay on disk. Avoid git clean -fdx: it deletes local run caches.
# Ignore rules never untrack an already tracked file; review staged paths.

# V5m-2.1: verified archives plus bounded UTF-8 reports for text-only connectors.
# Earlier published V5m-2 outputs stay immutable; no files are untracked here.
/.v5m21-building-*/
/review-v5m21*-results/*
!/review-v5m21*-results/README.md
!/review-v5m21*-results/summary.json
!/review-v5m21*-results/summary.json.gz
!/review-v5m21*-results/manifest.json
!/review-v5m21*-results/manifest.json.gz
!/review-v5m21*-results/publication-index.json
!/review-v5m21*-results/artifact-hashes.json
!/review-v5m21*-results/report-*.csv
!/review-v5m21*-results/table-*.csv.gz
!/review-v5m21*-results/archive-artifact-hashes.json.gz
!/review-v5m21*-results/archive-catalog-rejections.csv.gz
!/review-v5m21*-results/archive-catalog.csv.gz
!/review-v5m21*-results/archive-catalog.json.gz
!/review-v5m21*-results/archive-coarse-tradeoffs.csv.gz
!/review-v5m21*-results/archive-grid-plan.json.gz
!/review-v5m21*-results/archive-manifest.json.gz
!/review-v5m21*-results/archive-pareto-thermodynamic.csv.gz
!/review-v5m21*-results/archive-pareto-with-flow-proxy.csv.gz
!/review-v5m21*-results/archive-prediction-grid.csv.gz
!/review-v5m21*-results/archive-predictions.json.gz
!/review-v5m21*-results/archive-refinement-diagnostics.csv.gz
!/review-v5m21*-results/archive-refinement-plan.json.gz
!/review-v5m21*-results/archive-summary.json.gz
!/review-v5m21*-results/archive-tradeoffs.csv.gz
!/review-v5m21*-results/archive-validation-shortlist.csv.gz
/review-v5m21*-results/*/
