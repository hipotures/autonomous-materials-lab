# Cache blobs, numerical workers, failed partial runs and locks stay local.
/.campaign-cache/
/.campaign-work/
__pycache__/

# Immutable published snapshots; exact artifacts plus bounded report families.
/campaign-v5m3*-results/*
!/campaign-v5m3*-results/latest.json
!/campaign-v5m3*-results/run-*/
/campaign-v5m3*-results/run-*/*
!/campaign-v5m3*-results/run-*/summary.json
!/campaign-v5m3*-results/run-*/summary.json.gz
!/campaign-v5m3*-results/run-*/manifest.json
!/campaign-v5m3*-results/run-*/manifest.json.gz
!/campaign-v5m3*-results/run-*/registry.json
!/campaign-v5m3*-results/run-*/registry.json.gz
!/campaign-v5m3*-results/run-*/changes.json
!/campaign-v5m3*-results/run-*/changes.json.gz
!/campaign-v5m3*-results/run-*/scientific-results.json.gz
!/campaign-v5m3*-results/run-*/water-controls.json.gz
!/campaign-v5m3*-results/run-*/evidence-needs.json.gz
!/campaign-v5m3*-results/run-*/task-graph.json.gz
!/campaign-v5m3*-results/run-*/catalog.json.gz
!/campaign-v5m3*-results/run-*/execution-events.json.gz
!/campaign-v5m3*-results/run-*/pair-*.json.gz
!/campaign-v5m3*-results/run-*/report-*.csv.gz
!/campaign-v5m3*-results/run-*/preview-*.md
!/campaign-v5m3*-results/run-*/table-*.csv.gz
!/campaign-v5m3*-results/run-*/publication-index.json
!/campaign-v5m3*-results/run-*/publication-index.before-csv-repack.json.gz
/campaign-v5m3*-results/run-*/*/

# Alternate --cache-dir/results-dir paths need an explicit publication policy.
# Ignore rules do not untrack files. Never use git clean -fdx on a research tree.

# Broad mission snapshots. Worker files and arbitrary additions remain excluded.
/mission-v5m4*-results/*
!/mission-v5m4*-results/latest.json
!/mission-v5m4*-results/run-*/
/mission-v5m4*-results/run-*/*
!/mission-v5m4*-results/run-*/summary.json
!/mission-v5m4*-results/run-*/summary.json.gz
!/mission-v5m4*-results/run-*/manifest.json
!/mission-v5m4*-results/run-*/manifest.json.gz
!/mission-v5m4*-results/run-*/scientific-results.json.gz
!/mission-v5m4*-results/run-*/catalog.json.gz
!/mission-v5m4*-results/run-*/mission-profile.json.gz
!/mission-v5m4*-results/run-*/task-graph.json.gz
!/mission-v5m4*-results/run-*/execution-events.json.gz
!/mission-v5m4*-results/run-*/changes.json.gz
!/mission-v5m4*-results/run-*/pair-*.json.gz
!/mission-v5m4*-results/run-*/report-*.csv.gz
!/mission-v5m4*-results/run-*/preview-*.md
!/mission-v5m4*-results/run-*/table-*.csv.gz
!/mission-v5m4*-results/run-*/publication-index.json
!/mission-v5m4*-results/run-*/publication-index.before-csv-repack.json.gz
/mission-v5m4*-results/run-*/*/

# V5m-4.1 stores immutable shared dossiers once, across cumulative snapshots.
!/mission-v5m41-results/objects/
/mission-v5m41-results/objects/*
!/mission-v5m41-results/objects/*.json.gz
/mission-v5m41-results/objects/*/
!/mission-v5m41-results/run-*/registry.json.gz
